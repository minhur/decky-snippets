{
  "name": "snippets",
  "version": "1.1.0",
  "description": "Stored text snippets for Steam Deck game mode: one tap pastes (types) the text into the focused field, or copies it for the on-screen keyboard's paste key.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhur/decky-snippets.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "snippets"
  ],
  "author": "minhur (fork of xXJSONDeruloXx/snippets)",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/minhur/decky-snippets/issues"
  },
  "homepage": "https://github.com/minhur/decky-snippets#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
